{
  "id": "/",
  "name": "MatContactHub",
  "short_name": "ContactHub",
  "description": "Your contact directory: contacts from REST, SQL Server and CSV, address books, duplicates and an LDAP server for phones. Dein Kontaktverzeichnis: Kontakte aus REST, SQL Server und CSV, Adressbücher, Dubletten und ein LDAP-Server für Telefone.",
  "start_url": "/Contacts",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f5f4f1",
  "theme_color": "#f5f4f1",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "New contact / Neuer Kontakt",
      "short_name": "New contact",
      "url": "/Contacts/Edit",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Address books / Adressbücher",
      "short_name": "Address books",
      "url": "/AddressBooks",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Duplicates / Dubletten",
      "short_name": "Duplicates",
      "url": "/Duplicates",
      "icons": [{ "src": "/img/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
