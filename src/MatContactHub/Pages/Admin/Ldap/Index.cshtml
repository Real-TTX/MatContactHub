@page "/Admin/Ldap"
@model MatContactHub.Pages.Admin.Ldap.IndexModel
@{
    ViewData["Title"] = L["Ldap.Title"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Admin.Title"].Value, null), (L["Ldap.Title"].Value, null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("server")@L["Ldap.General"]</h2></div>
                <div class="mat-card__body mat-form">
                    <md-field name="Enabled" kind="switch" label="@L["Ldap.Enabled"]" value="@Model.Enabled.ToString()" />
                    <md-field name="StartTlsEnabled" kind="switch" label="@L["Ldap.StartTls"]" value="@Model.StartTlsEnabled.ToString()" />
                    <md-field name="LdapsEnabled" kind="switch" label="@L["Ldap.Ldaps"]" value="@Model.LdapsEnabled.ToString()" />
                    <md-field name="BaseDn" label="@L["Ldap.BaseDn"]" required value="@Model.BaseDn" maxlength="255" mono />
                    <md-field name="AllowAnonymous" kind="switch" label="@L["Ldap.AllowAnonymous"]" value="@Model.AllowAnonymous.ToString()" hint="@L["Ldap.AllowAnonymous.Hint"]" />
                    <md-field name="NumberFormat" kind="select" label="@L["Ldap.NumberFormat"]" value="@Model.NumberFormat" options="Model.NumberFormats" />
                    <md-field name="DefaultCountry" label="@L["System.DefaultCountry"]" value="@Model.DefaultCountry" maxlength="2" autocomplete="off" hint="@L["System.DefaultCountry.Hint"]" />
                    <md-field name="SizeLimit" kind="number" label="@L["Ldap.SizeLimit"]" value="@Model.SizeLimit" min="1" max="100000" inputmode="numeric" />
                </div>
            </div>
            <md-buttons save="@L["Common.Save"]" back="/Contacts" />
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("info")@L["Ldap.Ports"]</h2></div>
            <div class="mat-card__body">
                <dl class="mat-kv">
                    <dt>LDAP / StartTLS</dt><dd class="mat-mono">@LdapSettings.Port</dd>
                    <dt>LDAPS</dt><dd class="mat-mono">@LdapSettings.SecurePort</dd>
                </dl>
                <p class="md-muted md-mt">@L["Ldap.Ports.Text"]</p>
                <p class="md-placeholder">@L["Common.NotYet"]</p>
            </div>
        </div>
    </div>
</div>
