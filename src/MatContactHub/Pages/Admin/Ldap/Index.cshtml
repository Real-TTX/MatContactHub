@page "/Admin/Ldap"
@model MatContactHub.Pages.Admin.Ldap.IndexModel
@{
    ViewData["Title"] = L["Ldap.Title"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Admin.Title"].Value, null), (L["Ldap.Title"].Value, Model.Tab == "general" ? null : "/Admin/Ldap"), (L["Ldap.Tab." + Model.Tab].Value, null) };
}

<md-tabs label="@L["Ldap.Tabs"]">
    @foreach (var tab in IndexModel.Tabs)
    {
        <md-tab href="@(tab == "general" ? "/Admin/Ldap" : "/Admin/Ldap?tab=" + tab)" active="@(Model.Tab == tab)">@L["Ldap.Tab." + tab]</md-tab>
    }
</md-tabs>

@switch (Model.Tab)
{
    case "certificate":
        <partial name="_Certificate" model="Model" />
        break;
    case "accounts":
        <partial name="_Accounts" model="Model" />
        break;
    case "log":
        <partial name="_Log" model="Model" />
        break;
    case "help":
        <partial name="_Help" model="Model" />
        break;
    default:
        <partial name="_General" model="Model" />
        break;
}
