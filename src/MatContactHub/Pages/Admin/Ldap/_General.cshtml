@model MatContactHub.Pages.Admin.Ldap.IndexModel
@* The tab General: the settings of the server, and beside them its state (ports, the directory in memory, the open connections). *@
@{
    var s = Model.Status;
    var problem = s.Error is not null || (s.Enabled && (s.PortError is not null || (s.Ldaps && s.SecurePortError is not null)));
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("server")@L["Ldap.General"]</h2></div>
                <div class="mat-card__body mat-form">
                    <md-field name="Enabled" kind="switch" label="@L["Ldap.Enabled"]" value="@Model.Enabled.ToString()" hint="@L["Ldap.Enabled.Hint"]" />
                    <md-field name="StartTlsEnabled" kind="switch" label="@L["Ldap.StartTls"]" value="@Model.StartTlsEnabled.ToString()" hint="@L["Ldap.StartTls.Hint"]" />
                    <md-field name="LdapsEnabled" kind="switch" label="@L["Ldap.Ldaps"]" value="@Model.LdapsEnabled.ToString()" hint="@L["Ldap.Ldaps.Hint"]" />
                    <md-field name="BaseDn" label="@L["Ldap.BaseDn"]" required value="@Model.BaseDn" maxlength="255" mono autocomplete="off" hint="@L["Ldap.BaseDn.Hint"]" />
                    <md-field name="AllowAnonymous" kind="switch" label="@L["Ldap.AllowAnonymous"]" value="@Model.AllowAnonymous.ToString()" hint="@L["Ldap.AllowAnonymous.Hint"]" />
                    <md-field name="NumberFormat" kind="radios" label="@L["Ldap.NumberFormat"]" value="@Model.NumberFormat" options="Model.NumberFormats" hint="@L["Ldap.NumberFormat.Hint"]" />
                    <md-field name="DefaultCountry" label="@L["System.DefaultCountry"]" required value="@Model.DefaultCountry" maxlength="2" autocomplete="off" hint="@L["System.DefaultCountry.Hint"]" />
                    <md-field name="SizeLimit" kind="number" label="@L["Ldap.SizeLimit"]" required value="@Model.SizeLimit" min="1" max="100000" inputmode="numeric" hint="@L["Ldap.SizeLimit.Hint"]" />
                </div>
            </div>
            <md-buttons save="@L["Common.Save"]" back="/Contacts" />
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-stack">
            <section class="mat-card" aria-labelledby="ldap-state">
                <div class="mat-card__head">
                    <h2 class="mat-card__title" id="ldap-state">@Ui.Icon("activity")@L["Ldap.Status"]</h2>
                    @if (!s.Enabled)
                    {
                        <span class="mat-pill mat-pill--plain">@L["Ldap.Status.Off"]</span>
                    }
                    else if (problem)
                    {
                        <span class="mat-pill mat-pill--error">@L["Ldap.Status.Problem"]</span>
                    }
                    else
                    {
                        <span class="mat-pill mat-pill--ok">@L["Ldap.Status.Running"]</span>
                    }
                </div>
                <div class="mat-card__body mat-stack">
                    @if (s.Error is not null)
                    {
                        <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<div class="mat-alert__body">@L["Ldap.Status.LoadError", s.Error]</div></div>
                    }
                    @if (s.Enabled && s.PortError is not null)
                    {
                        <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<div class="mat-alert__body">@L["Ldap.Status.PortError", s.ConfiguredPort, s.PortError]</div></div>
                    }
                    @if (s.Enabled && s.Ldaps && s.SecurePortError is not null)
                    {
                        <div class="mat-alert mat-alert--danger" role="alert">@Ui.Icon("alert")<div class="mat-alert__body">@L["Ldap.Status.PortError", s.ConfiguredSecurePort, s.SecurePortError]</div></div>
                    }
                    @if (s.Enabled && (s.Ldaps || s.StartTls) && !s.HasCertificate)
                    {
                        <div class="mat-alert mat-alert--warning" role="status">@Ui.Icon("lock")<div class="mat-alert__body">@L["Ldap.Status.NoCertificate"]</div></div>
                    }
                    <dl class="mat-kv">
                        <dt>@L["Ldap.Status.Plain"]</dt>
                        <dd class="mat-mono">@(s.Port?.ToString() ?? L["Ldap.Status.PortOff"].Value)</dd>
                        <dt>@L["Ldap.Status.Secure"]</dt>
                        <dd class="mat-mono">@(s.SecurePort?.ToString() ?? L["Ldap.Status.PortOff"].Value)</dd>
                        <dt>@L["Ldap.Status.Built"]</dt>
                        <dd>@(s.BuiltUtc is { } built ? Dates.Stamp(built, Model.Zone) : L["Ldap.Status.NotBuilt"].Value)</dd>
                    </dl>
                    <p class="md-muted">@L["Ldap.Ports.Text"]</p>
                </div>
            </section>
            <div class="mat-stats">
                <a class="mat-stat" href="/AddressBooks"><span class="mat-stat__label">@L["Ldap.Stat.AddressBooks"]</span><span class="mat-stat__value">@s.AddressBooks.ToString("N0")</span></a>
                <div class="mat-stat"><span class="mat-stat__label">@L["Ldap.Stat.Contacts"]</span><span class="mat-stat__value">@s.Contacts.ToString("N0")</span></div>
                <a class="mat-stat" href="/Admin/Ldap?tab=accounts"><span class="mat-stat__label">@L["Ldap.Stat.Accounts"]</span><span class="mat-stat__value">@s.Accounts.ToString("N0")</span></a>
                <div class="mat-stat"><span class="mat-stat__label">@L["Ldap.Stat.Connections"]</span><span class="mat-stat__value">@s.Connections.Count.ToString("N0")</span></div>
            </div>
            <section class="mat-card" aria-labelledby="ldap-connections">
                <div class="mat-card__head"><h2 class="mat-card__title" id="ldap-connections">@Ui.Icon("network")@L["Ldap.Connections"]</h2></div>
                @if (s.Connections.Count == 0)
                {
                    <div class="mat-card__body"><p class="md-muted">@L["Ldap.Connections.None"]</p></div>
                }
                else
                {
                    <ul class="mat-itemlist">
                        @foreach (var c in s.Connections.Take(50))
                        {
                            <li class="mat-item">
                                <div class="mat-item__main">
                                    <span class="mat-item__lead">@Ui.Icon(c.Secure ? "lock" : "plug")</span>
                                    <span class="mat-item__body">
                                        <span class="mat-item__title mat-mono">@c.Client</span>
                                        <span class="mat-item__text">@L["Ldap.Connections.Since", Dates.Stamp(c.SinceUtc, Model.Zone), c.Requests]</span>
                                    </span>
                                    <span class="mat-item__end">
                                        @if (c.Secure) { <span class="mat-pill mat-pill--ok">@L["Ldap.Connection.Tls"]</span> }
                                        <span class="mat-pill mat-pill--plain">@(c.BindName ?? L["Ldap.Connection.Anonymous"].Value)</span>
                                    </span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
</div>
