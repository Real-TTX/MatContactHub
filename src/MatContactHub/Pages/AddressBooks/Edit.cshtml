@page "/AddressBooks/Edit"
@model MatContactHub.Pages.AddressBooks.EditModel
@{
    ViewData["Title"] = Model.IsNew ? L["AddressBooks.New"].Value : Model.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["AddressBooks.Title"].Value, "/AddressBooks"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
    ViewData["NavKey"] = "addressbooks";
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <md-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" />
            <md-field name="Description" kind="textarea" label="@L["AddressBooks.Description"]" value="@Model.Description" maxlength="1000" optional rows="2" />
            <md-field name="IsShared" kind="switch" label="@L["AddressBooks.Shared"]" value="@Model.IsShared.ToString()" hint="@L["AddressBooks.Shared.Hint"]" />
            <md-field name="LdapEnabled" kind="switch" label="@L["AddressBooks.LdapEnabled"]" value="@Model.LdapEnabled.ToString()" />
            <md-field name="LdapName" label="@L["AddressBooks.LdapName"]" value="@Model.LdapName" maxlength="64" optional mono hint="@L["AddressBooks.LdapName.Hint"]" />
            <md-field name="AppsEnabled" kind="switch" label="@L["AddressBooks.Apps"]" value="@Model.AppsEnabled.ToString()" hint="@L["AddressBooks.Apps.Hint"]" />
            <md-field name="Color" kind="colour" label="@L["Common.Color"]" value="@Model.Color" optional picker="clearable" hint="@L["AddressBooks.Color.Hint"]" />
            <md-field name="SortOrder" kind="number" label="@L["AddressBooks.SortOrder"]" value="@Model.SortOrder" inputmode="numeric" />
        </div>
    </div>
    <md-buttons save="@L["Common.Save"]" back="/AddressBooks" delete-handler="@(Model.IsNew ? null : "Delete")" delete-confirm="@L["AddressBooks.DeleteConfirm", Model.Name]" />
</form>
